# Copy to .env (repo root) and fill in. Never commit .env.
# With FOOTNOTE_OFFLINE=1 nothing below is needed: fakes serve the models, the database and the index.
FOOTNOTE_OFFLINE=0

# Model provider: each route in backend/config/models.yaml names one; this switches every route
# to a preset: anthropic (Claude, the default) | openai (cheapest OpenAI tiers) | openai-quality.
FOOTNOTE_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Storage with real models: cloud (MongoDB + Pinecone) | local (in memory, over the bundled
# public-domain snapshot; for trying real models before a database exists).
FOOTNOTE_STORAGE=cloud

# MongoDB: local (docker compose up mongo) or a free Atlas M0 cluster of your own.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=footnote

# Pinecone (Starter plan works): the index is created on first ingest.
PINECONE_API_KEY=
PINECONE_INDEX=footnote
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# LangSmith tracing and eval experiments (optional).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=footnote

# Required by Wikimedia's User-Agent policy to fetch Wikipedia/Wikidata: your project URL or an
# email address you read. It is sent only to the corpus sources, in the User-Agent header.
FOOTNOTE_FETCH_CONTACT=

# The fine-tuned judge served by Ollama (see finetune/export), and which judge the agents use.
LOCAL_JUDGE_URL=
LOCAL_JUDGE_MODEL=footnote-judge
FOOTNOTE_JUDGE_BACKEND=api   # api (the judge.grounding route) | local | cascade

# Public demo protection.
CORS_ORIGINS=["http://localhost:3000"]
RATE_LIMIT_PER_MINUTE=12
DAILY_BUDGET_USD=5
MCP_ALLOWED_HOSTS=[]
# Optional bearer authentication. JSON maps stable owner ids to independent keys. When set, all
# agent routes, draft routes, and HTTP MCP calls require a key; drafts are visible only to owner.
# FOOTNOTE_API_KEYS={"alice":"replace-with-a-long-random-secret"}
